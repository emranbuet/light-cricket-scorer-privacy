  "steps": [
    {
      "id": "s1",
      "title": "Boil the pasta",
      "instruction": "Bring a large pot of salted water to a boil and cook the pappardelle until just shy of al dente. Save a mug of pasta water, then drain.",
      "durationSeconds": 600,
      "ingredientIds": [
