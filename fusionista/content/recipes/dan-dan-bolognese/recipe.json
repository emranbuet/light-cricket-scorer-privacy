    },
    {
      "id": "s2",
      "title": "Brown the pork",
      "instruction": "Heat the oil in a wide pan over medium-high heat. Add the pork, break it up, and cook until the moisture cooks off and the meat is browned in places, about 8 minutes.",
      "durationSeconds": 480,
      "ingredientIds": [
        "i2",
        "i3"
      ],
      "imageQuery": "browning ground pork pan"
    },
    {
      "id": "s3",
      "title": "Build the sauce",
      "instruction": "Stir in the garlic, ginger and doubanjiang and cook for 1 minute until fragrant. Add the soy sauce and Shaoxing wine, then the sesame paste, chili oil, half the Sichuan pepper and the stock. Simmer 5 minutes until thick and glossy.",
      "durationSeconds": 420,
